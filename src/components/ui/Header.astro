---
// src/components/ui/Header.astro
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Treatments", href: "/treatments" },
  { label: "Dental Implants", href: "/treatments#implants" },
  { label: "Advanced Tech", href: "/#assurance" },
  { label: "About Doctors", href: "/reviews#doctors" },
  { label: "Patient Reviews", href: "/reviews" },
  { label: "Contact", href: "/contact" },
];
---

<!-- Top Emergency & Utility Bar (Height: 36px, Background: #0F2537, Text: #F8FAFC, Font Size: 13px) -->
<div class="h-9 min-h-[36px] bg-[#0F2537] text-[#F8FAFC] text-[13px] px-4 sm:px-6 flex items-center justify-between border-b border-slate-800 z-50 relative">
  <div class="flex items-center gap-2 font-medium">
    <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
    <span class="truncate">Balawala, Dehradun | Open Daily: 8:00 AM – 9:00 PM</span>
  </div>
  <div class="flex items-center gap-4">
    <a
      href="tel:+917018021512"
      class="hover:text-[#0D9488] transition-colors font-semibold flex items-center gap-1.5"
      aria-label="Call clinic directly"
    >
      <span>📞 Call Clinic / Emergency:</span>
      <span class="underline decoration-[#0D9488] underline-offset-2">+91 70180 21512</span>
    </a>
  </div>
</div>

<!-- Main Navigation Bar (Sticky, Background: #FFFFFF with 80% backdrop blur and 1px border-bottom #E2E8F0) -->
<header class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-[#E2E8F0] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <!-- Left: Brand Emblem & Wordmark in authoritative Semi-Bold slate typography -->
    <a
      href="/"
      class="flex items-center gap-3 text-[#0F2537] group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D9488] rounded-md"
      aria-label="Uniyal Oro Dental Clinic & Implant Centre Home"
    >
      <div class="w-10 h-10 rounded-xl bg-[#E6FFFA] border border-[#0D9488]/30 flex items-center justify-center text-[#0D9488] transition-transform group-hover:scale-105 shrink-0 shadow-xs">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2C8.5 2 6 4.5 6 7.5c0 2 .8 4.2 1.5 6.5.8 2.5 1.5 5 2.5 7 1 .5 2 1 2 .5.5-2.5 1.2-5 2-7.5.7-2.3 1.5-4.5 1.5-6.5C18 4.5 15.5 2 12 2z"></path>
          <path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-bold tracking-tight text-[#0F2537] group-hover:text-[#0D9488] transition-colors whitespace-nowrap">
          Uniyal Oro Dental Clinic
        </span>
        <span class="text-[11px] font-semibold text-[#475569] tracking-wider uppercase">
          & Implant Centre · Balawala
        </span>
      </div>
    </a>

    <!-- Center: Clean Nav Links -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 text-sm font-semibold rounded-lg transition-all duration-150 active:scale-95 whitespace-nowrap",
              isActive
                ? "text-[#0D9488] bg-[#E6FFFA]"
                : "text-[#475569] hover:text-[#0F2537] hover:bg-slate-50"
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Prominent primary CTA button -->
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-bold text-white bg-[#0D9488] hover:bg-[#0F766E] rounded-xl shadow-xs transition-all duration-150 active:scale-95 whitespace-nowrap"
        aria-label="Book a dental consultation appointment"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Book Appointment</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-[#475569] hover:text-[#0F2537] hover:bg-slate-100 border border-[#E2E8F0]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="hidden lg:hidden border-t border-[#E2E8F0] bg-white px-4 py-4 space-y-2 animate-fade-slide-in shadow-lg">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-semibold text-[#0F2537] hover:bg-[#F8FAFC] transition-colors"
      >
        <span>{item.label}</span>
        <span class="text-xs text-[#0D9488]">→</span>
      </a>
    ))}
    <div class="pt-3 border-t border-[#E2E8F0] flex flex-col gap-2">
      <a
        href="tel:+917018021512"
        class="flex items-center justify-center gap-2 py-2.5 text-xs font-bold rounded-lg bg-[#0F2537] text-white"
      >
        📞 Call Clinic: +91 70180 21512
      </a>
      <a
        href="https://wa.me/917018021512?text=Hello%20Uniyal%20Dental%20Clinic,%20I%20would%20like%20to%20book%20a%20consultation."
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-2.5 text-xs font-bold rounded-lg bg-[#25D366] text-white"
      >
        💬 WhatsApp Consultation
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-nav-drawer");
    const openIcon = document.getElementById("menu-icon-open");
    const closeIcon = document.getElementById("menu-icon-close");

    if (!btn || !drawer) return;

    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));
      drawer.classList.toggle("hidden");
      if (openIcon && closeIcon) {
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      }
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
